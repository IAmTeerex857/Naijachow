# NaijaPlate — server-side secrets template.
# Copy this file to `.env` (which is gitignored) and fill in real values for LOCAL dev.
# For PRODUCTION, set these in Netlify → Site settings → Environment variables (never commit real keys).
# NEVER prefix these with VITE_ — that would expose them to the browser. All keys are used
# only inside the Netlify Functions in netlify/functions/.

# Claude API (pay-as-you-go). Used by generate-plan and swap-meal.
ANTHROPIC_API_KEY=

# Google Programmable Search (image fetch — last-resort layer, 100 free queries/day).
# Requires the "Custom Search API" to be ENABLED in your Google Cloud project.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Supabase — permanent image cache (image_cache table). Use the sb_secret_... service key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
