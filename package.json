{
  "name": "naijaplate",
  "version": "2.0.0",
  "private": true,
  "description": "NaijaPlate - Nigerian meal-planning web app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npx vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:trigger": "tsc --noEmit -p tsconfig.trigger.json",
    "check": "npm run test && npm run typecheck:trigger && npm run build",
    "trigger:dev": "npx trigger.dev dev",
    "trigger:deploy": "npx trigger.dev deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@trigger.dev/sdk": "^4.6.4",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-react": "^6.1.1",
    "trigger.dev": "^4.6.4",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
